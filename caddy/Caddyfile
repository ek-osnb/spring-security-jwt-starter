{$SITE_ADDRESS} {

    handle /.well-known/jwks.json {
        reverse_proxy {$API_UPSTREAM}
    }

    handle /oauth2/* {
        reverse_proxy {$API_UPSTREAM}
    }

    handle /login/oauth2/* {
        reverse_proxy {$API_UPSTREAM}
    }

	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}

	handle {
		reverse_proxy {$FRONTEND_UPSTREAM}
	}
}